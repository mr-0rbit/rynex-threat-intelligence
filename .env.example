# RTIP backend configuration — copy to .env and fill in real values.
# NEVER commit .env. All values below are placeholders / dev defaults.

# ---------- Core ----------
ENVIRONMENT=development
DEBUG=true

# ---------- Database ----------
# Dev default (SQLite). Docker Compose overrides this with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./rtip.db

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- Auth ----------
# CHANGE JWT_SECRET_KEY IN PRODUCTION (e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`)
JWT_SECRET_KEY=CHANGE_ME_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Auth hardening ----------
# Login rate limiting (per-IP sliding window). Disable only in tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# ---------- Data retention ----------
# Days to keep collection-job history; 0 disables the purge. Intel records are never auto-deleted.
RETENTION_COLLECTION_JOBS_DAYS=90

# ---------- Initial admin bootstrap (first run only) ----------
ADMIN_EMAIL=admin@rynex.local
ADMIN_PASSWORD=ChangeMeNow!2024

# ---------- Notifications (all optional; channels activate when set) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WEBHOOK_URL=

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- Collector HTTP behaviour ----------
COLLECTOR_TIMEOUT_SECONDS=30
COLLECTOR_MAX_RETRIES=3
# Only enable when deliberately testing against internal feeds
ALLOW_PRIVATE_NETWORK_SOURCES=false

# ---------- Optional collector API keys (free registrations) ----------
# abuse.ch Auth-Key: https://auth.abuse.ch/
THREATFOX_AUTH_KEY=
URLHAUS_AUTH_KEY=
# Ransomware.live (optional; free tier works without a key)
RANSOMWARELIVE_API_KEY=

# ---------- Optional MISP collector (manual trigger only) ----------
MISP_URL=
MISP_API_KEY=
MISP_MAX_AGE_DAYS=30

# ---------- Optional NVD enrichment (free key raises rate limits) ----------
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_MAX_AGE_DAYS=7

# ---------- Enterprise Distributed Architecture ----------
REDIS_ALERT_CHANNEL=rtip:events:alerts

# ---------- Enterprise Single Sign-On (OIDC / OAuth2) ----------
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/oidc/callback
OIDC_DEFAULT_ROLE=viewer
OIDC_ORGANIZATION_SLUG=default

# ---------- Enterprise Audit Integrity ----------
AUDIT_HMAC_KEY=change-this-to-a-secure-hmac-key-for-audit-trail

# ---------- Trusted reverse proxies ----------
# Comma-separated proxy CIDRs; leave empty unless requests arrive through a trusted proxy.
TRUSTED_PROXY_CIDRS=

# ---------- Enterprise Protocols ----------
TAXII_ENABLED=true
IOC_DECAY_ENABLED=true

# ---------- Docker Compose only ----------
POSTGRES_USER=rtip
POSTGRES_PASSWORD=
POSTGRES_DB=rtip
