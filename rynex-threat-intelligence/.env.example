# =============================================================================
# RYNEX THREAT INTELLIGENCE PLATFORM — environment configuration
# Copy to .env and fill in. NEVER commit the populated .env file.
# =============================================================================

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL in Docker; SQLite for quick local dev) ------------
# Docker Compose:  postgresql+asyncpg://rtip:CHANGE_ME@postgres:5432/rtip
DATABASE_URL=postgresql+asyncpg://rtip:CHANGE_ME_STRONG_PASSWORD@postgres:5432/rtip
POSTGRES_USER=rtip
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rtip

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@rynex.local
# Change immediately after first login:
ADMIN_PASSWORD=ChangeMeNow!2024

# --- Intelligence source API keys (all optional; sources degrade gracefully) --
# abuse.ch Auth-Keys (free): https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
THREATFOX_AUTH_KEY=
# abuse.ch MalwareBazaar (free): https://auth.abuse.ch/
MALWAREBAZAAR_AUTH_KEY=
# AlienVault OTX (free): https://otx.alienvault.com/api/
OTX_API_KEY=
# AbuseIPDB (free tier): https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# GreyNoise (free community): https://viz.greynoise.io/signup
GREYNOISE_API_KEY=
# Have I Been Pwned (paid per-lookup; free domain monitoring via notifications):
HIBP_API_KEY=
# urlscan.io (free): https://urlscan.io/docs/api/
URLSCAN_API_KEY=
# NVD (optional; raises rate limits): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Ransomware.live (optional partner key): https://www.ransomware.live/
RANSOMWARELIVE_API_KEY=

# --- Notifications (Phase 8) --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=rtip@rynex.tech
WEBHOOK_URL=
